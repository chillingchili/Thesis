      "id": "C6_PADDLE_REVIEW",
      "condition": "paddle_outside_baseline",
      "serve_types": ["drive", "lob", "topspin"],
      "text": "Your measured paddle angle is outside the reference range. Review your paddle orientation at contact.",
      "source_clips": ["Beginner2_Drive_010.mp4", "Beginner2_Topspin_002.mp4", "Beginner1_Lob_019.mp4"]
    },
    {
      "id": "C6_TOO_OPEN",
      "condition": "paddle_too_open",
      "serve_types": ["drive", "lob"],
      "text": "Reduce the upward-facing paddle angle at contact and carry the swing forward.",
      "source_clips": ["Beginner2_Drive_010.mp4", "Beginner1_Lob_019.mp4"]
    },
    {
      "id": "C6_TOO_CLOSED",
      "condition": "paddle_too_closed",
