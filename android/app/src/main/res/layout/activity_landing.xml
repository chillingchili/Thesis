<?xml version="1.0" encoding="utf-8"?>
<!-- Ball landing review (second phone): full-bleed camera or replay, a Material
     top bar on a scrim, and a status card that leads with the zone. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.camera.view.PreviewView
        android:id="@+id/landingPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ImageView
        android:id="@+id/replayFrame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <com.thesis.pickleballserve.landing.LandingOverlayView
        android:id="@+id/landingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/landingTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/top_scrim"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="18dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/backButton"
            style="@style/Widget.Serve.IconButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/back_to_live"
            app:icon="@drawable/ic_arrow_left"
            app:iconTint="@color/on_camera" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:accessibilityHeading="true"
            android:text="@string/landing_screen_title"
            android:textAppearance="@style/TextAppearance.Serve.Title"
            android:textColor="@color/on_camera"
            android:textSize="17sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/landingHelpButton"
            style="@style/Widget.Serve.IconButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/landing_info_title"
            app:icon="@drawable/ic_help"
            app:iconTint="@color/on_camera" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/loadVideoButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:minHeight="44dp"
            android:text="@string/load_video"
            android:textColor="@color/on_camera"
            app:backgroundTint="#29FFFFFF"
            app:icon="@drawable/ic_video"
            app:iconTint="@color/on_camera" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/shareButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:minHeight="44dp"
            android:text="@string/share_landing"
            android:textColor="#171717"
            app:backgroundTint="#FFFFFF"
            app:icon="@drawable/ic_share"
            app:iconTint="#171717" />
    </LinearLayout>

    <TextView
        android:id="@+id/landingStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="12dp"
        android:background="@drawable/status_card"
        android:maxWidth="460dp"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp"
        android:accessibilityLiveRegion="polite"
        android:text="@string/landing_starting"
        android:textAppearance="@style/TextAppearance.Serve.Body"
        android:textColor="@color/on_camera"
        android:textSize="14sp" />

</FrameLayout>
