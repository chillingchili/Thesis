<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Material 3 components themed with Astryx Neutral tokens (colors.xml, values-night). -->
    <style name="Theme.PickleballServe" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/on_accent</item>
        <item name="colorPrimaryContainer">@color/accent_muted</item>
        <item name="colorOnPrimaryContainer">@color/text_primary</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">@color/on_accent</item>
        <item name="colorSecondaryContainer">@color/accent_muted</item>
        <item name="colorOnSecondaryContainer">@color/text_primary</item>
        <item name="colorTertiary">@color/select</item>
        <item name="android:colorBackground">@color/body</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/accent_muted</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorSurfaceContainerLowest">@color/surface</item>
        <item name="colorSurfaceContainerLow">@color/surface</item>
        <item name="colorSurfaceContainer">@color/surface</item>
        <item name="colorSurfaceContainerHigh">@color/surface</item>
        <item name="colorSurfaceContainerHighest">@color/accent_muted</item>
        <item name="colorOutline">@color/border_em</item>
        <item name="colorOutlineVariant">@color/border</item>
        <item name="colorError">@color/err</item>
        <item name="colorOnError">@color/on_accent</item>
        <item name="android:windowBackground">@color/body</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="p">shortEdges</item>
        <item name="android:fontFamily">@font/figtree</item>
        <item name="fontFamily">@font/figtree</item>

        <item name="shapeAppearanceCornerSmall">@style/Shape.Serve.Small</item>
        <item name="shapeAppearanceCornerMedium">@style/Shape.Serve.Medium</item>
        <item name="shapeAppearanceCornerLarge">@style/Shape.Serve.Large</item>

        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.Serve.DialogTitle</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.Serve.DialogTitle</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.Serve.Title</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.Serve.Body</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.Serve.Body</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.Serve.Small</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.Serve.Button</item>

        <item name="materialButtonStyle">@style/Widget.Serve.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.Serve.Button.Outlined</item>
        <item name="borderlessButtonStyle">@style/Widget.Serve.Button.Text</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Serve.Dialog</item>
        <item name="snackbarStyle">@style/Widget.Serve.Snackbar</item>
        <item name="popupMenuStyle">@style/Widget.Serve.PopupMenu</item>
        <item name="android:popupMenuStyle">@style/Widget.Serve.PopupMenu</item>
    </style>

    <style name="Shape.Serve.Small" parent=""><item name="cornerFamily">rounded</item><item name="cornerSize">6dp</item></style>
    <style name="Shape.Serve.Medium" parent=""><item name="cornerFamily">rounded</item><item name="cornerSize">10dp</item></style>
    <style name="Shape.Serve.Large" parent=""><item name="cornerFamily">rounded</item><item name="cornerSize">12dp</item></style>

    <!-- Type: three sizes carry the live screen (cue 24, value 22, label 15). -->
    <style name="TextAppearance.Serve.Cue" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">@font/figtree_semibold</item><item name="fontFamily">@font/figtree_semibold</item>
        <item name="android:textSize">24sp</item><item name="android:letterSpacing">-0.01</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
    <style name="TextAppearance.Serve.Value" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/figtree_semibold</item><item name="fontFamily">@font/figtree_semibold</item>
        <item name="android:textSize">22sp</item><item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
    <style name="TextAppearance.Serve.Label" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">@font/figtree_medium</item><item name="fontFamily">@font/figtree_medium</item>
        <item name="android:textSize">15sp</item><item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>
    <style name="TextAppearance.Serve.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">@font/figtree_semibold</item><item name="fontFamily">@font/figtree_semibold</item>
        <item name="android:textSize">15sp</item><item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
    <style name="TextAppearance.Serve.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/figtree_regular</item><item name="fontFamily">@font/figtree_regular</item>
        <item name="android:textSize">15sp</item><item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
    <style name="TextAppearance.Serve.Small" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">@font/figtree_regular</item><item name="fontFamily">@font/figtree_regular</item>
        <item name="android:textSize">13sp</item><item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>
    <style name="TextAppearance.Serve.Badge" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/figtree_medium</item><item name="fontFamily">@font/figtree_medium</item>
        <item name="android:textSize">14sp</item><item name="android:letterSpacing">0</item>
    </style>
    <style name="TextAppearance.Serve.Button" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/figtree_semibold</item><item name="fontFamily">@font/figtree_semibold</item>
        <item name="android:textSize">15sp</item><item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="TextAppearance.Serve.DialogTitle" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">@font/figtree_semibold</item><item name="fontFamily">@font/figtree_semibold</item>
        <item name="android:textSize">20sp</item><item name="android:letterSpacing">0</item>
    </style>

    <!-- Buttons: Astryx element radius (10dp), no insets, 44dp+ tall. -->
    <style name="Widget.Serve.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">10dp</item><item name="android:insetTop">0dp</item><item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">48dp</item><item name="android:textAppearance">@style/TextAppearance.Serve.Button</item>
    </style>
    <style name="Widget.Serve.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">10dp</item><item name="android:insetTop">0dp</item><item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">48dp</item><item name="strokeColor">@color/border_em</item>
        <item name="android:textColor">@color/text_primary</item><item name="iconTint">@color/text_primary</item>
        <item name="android:textAppearance">@style/TextAppearance.Serve.Button</item>
    </style>
    <style name="Widget.Serve.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="cornerRadius">10dp</item><item name="android:insetTop">0dp</item><item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">48dp</item><item name="android:textColor">@color/text_primary</item>
        <item name="iconTint">@color/text_primary</item><item name="android:textAppearance">@style/TextAppearance.Serve.Button</item>
    </style>
    <style name="Widget.Serve.IconButton" parent="Widget.Material3.Button.IconButton">
        <item name="android:minWidth">48dp</item><item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item><item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item><item name="android:insetRight">0dp</item>
        <item name="cornerRadius">10dp</item><item name="iconSize">20dp</item><item name="iconTint">@color/text_primary</item>
    </style>
    <style name="Widget.Serve.HelpButton" parent="Widget.Serve.IconButton">
        <item name="iconSize">18dp</item><item name="iconTint">@color/icon_secondary</item>
        <item name="icon">@drawable/ic_help</item>
    </style>
    <!-- Overflow menu: one tonal step above the panel, 10dp radius, clear of the screen edge. -->
    <style name="Widget.Serve.PopupMenu" parent="Widget.Material3.PopupMenu">
        <item name="android:popupBackground">@drawable/menu_background</item>
        <item name="android:dropDownHorizontalOffset">-8dp</item>
        <item name="android:dropDownVerticalOffset">4dp</item>
    </style>
    <style name="Widget.Serve.Snackbar" parent="Widget.Material3.Snackbar">
        <item name="shapeAppearance">@style/Shape.Serve.Medium</item>
    </style>

    <style name="ThemeOverlay.Serve.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="materialAlertDialogTitleTextStyle">@style/Serve.DialogTitleText</item>
        <item name="materialAlertDialogBodyTextStyle">@style/Serve.DialogBodyText</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Serve.Button.Outlined</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Serve.Button.Text</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.Serve.Button.Text</item>
    </style>
    <style name="Serve.DialogTitleText" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textAppearance">@style/TextAppearance.Serve.DialogTitle</item>
    </style>
    <style name="Serve.DialogBodyText" parent="MaterialAlertDialog.Material3.Body.Text">
        <item name="android:textAppearance">@style/TextAppearance.Serve.Body</item>
    </style>

    <!-- Live panel building blocks. -->
    <style name="Serve.MetricRow" parent=""><item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item><item name="android:orientation">vertical</item><item name="android:paddingBottom">6dp</item></style>
    <style name="Serve.MetricHead" parent=""><item name="android:layout_width">match_parent</item><item name="android:layout_height">28dp</item><item name="android:orientation">horizontal</item><item name="android:gravity">center_vertical</item></style>
    <style name="Serve.MetricLabel" parent=""><item name="android:layout_width">wrap_content</item><item name="android:layout_height">wrap_content</item><item name="android:textAppearance">@style/TextAppearance.Serve.Label</item></style>
    <style name="Serve.MetricRef" parent=""><item name="android:layout_width">0dp</item><item name="android:layout_height">wrap_content</item><item name="android:layout_weight">1</item><item name="android:gravity">end</item><item name="android:textAppearance">@style/TextAppearance.Serve.Label</item><item name="android:textSize">14sp</item><item name="android:maxLines">1</item><item name="android:fontFeatureSettings">tnum</item></style>
    <style name="Serve.MetricValueRow" parent=""><item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item><item name="android:minHeight">28dp</item><item name="android:orientation">horizontal</item><item name="android:gravity">center_vertical</item></style>
    <style name="Serve.MetricValue" parent=""><item name="android:layout_width">wrap_content</item><item name="android:layout_height">wrap_content</item><item name="android:textAppearance">@style/TextAppearance.Serve.Value</item><item name="android:maxLines">1</item><item name="android:fontFeatureSettings">tnum</item></style>
    <style name="Serve.Badge" parent=""><item name="android:layout_width">wrap_content</item><item name="android:layout_height">wrap_content</item><item name="android:layout_marginStart">10dp</item><item name="android:background">@drawable/badge</item><item name="android:paddingStart">8dp</item><item name="android:paddingEnd">8dp</item><item name="android:paddingTop">3dp</item><item name="android:paddingBottom">3dp</item><item name="android:textAppearance">@style/TextAppearance.Serve.Badge</item><item name="android:maxLines">1</item></style>
    <style name="Serve.Divider" parent=""><item name="android:layout_width">match_parent</item><item name="android:layout_height">1dp</item><item name="android:background">@color/border</item></style>
    <style name="Serve.HelpButton" parent="Widget.Serve.HelpButton"><item name="android:layout_width">48dp</item><item name="android:layout_height">48dp</item><item name="android:layout_marginTop">-10dp</item><item name="android:layout_marginBottom">-10dp</item></style>
    <style name="Serve.CheckRow" parent=""><item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item><item name="android:minHeight">36dp</item><item name="android:orientation">horizontal</item><item name="android:gravity">center_vertical</item></style>
    <style name="Serve.CheckIcon" parent=""><item name="android:layout_width">20dp</item><item name="android:layout_height">20dp</item><item name="android:layout_marginEnd">10dp</item><item name="android:importantForAccessibility">no</item><item name="android:src">@drawable/ic_circle</item><item name="tint">@color/icon_secondary</item></style>
    <style name="Serve.CheckText" parent=""><item name="android:layout_width">0dp</item><item name="android:layout_height">wrap_content</item><item name="android:layout_weight">1</item><item name="android:textAppearance">@style/TextAppearance.Serve.Label</item><item name="android:textColor">@color/text_primary</item></style>
    <style name="Serve.Tip" parent=""><item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item><item name="android:minHeight">28dp</item><item name="android:gravity">center_vertical</item><item name="android:drawableStart">@drawable/dash</item><item name="android:drawablePadding">12dp</item><item name="android:paddingStart">3dp</item><item name="android:textAppearance">@style/TextAppearance.Serve.Body</item><item name="android:textSize">14sp</item><item name="android:textColor">@color/text_secondary</item></style>
    <style name="Serve.Fact" parent=""><item name="android:layout_width">wrap_content</item><item name="android:layout_height">wrap_content</item><item name="android:paddingTop">2dp</item><item name="android:paddingBottom">2dp</item><item name="android:textAppearance">@style/TextAppearance.Serve.Body</item><item name="android:textSize">14sp</item></style>
    <!-- Segmented control (Result | Research): outlined, filled when checked. -->
    <style name="Widget.Serve.Segment" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:insetTop">0dp</item><item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">44dp</item><item name="android:paddingStart">14dp</item><item name="android:paddingEnd">14dp</item>
        <item name="cornerRadius">10dp</item><item name="strokeColor">@color/border_em</item>
        <item name="backgroundTint">@color/segment_bg</item><item name="android:textColor">@color/segment_text</item>
        <item name="android:textAppearance">@style/TextAppearance.Serve.Button</item><item name="android:textSize">14sp</item>
    </style>
    <style name="Widget.Serve.ServeChip" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:insetTop">0dp</item><item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">48dp</item><item name="android:paddingStart">12dp</item><item name="android:paddingEnd">12dp</item>
        <item name="cornerRadius">10dp</item><item name="strokeColor">@color/border</item>
        <item name="backgroundTint">@color/surface</item><item name="android:textColor">@color/text_primary</item>
        <item name="android:textAppearance">@style/TextAppearance.Serve.Button</item><item name="android:textSize">14sp</item>
    </style>
</resources>
